@model Cart_King.Models.ViewModels.DashboardViewModel
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    
    var currentTab = Model.ActiveTab ?? "welcome";
}

<div class="row mt-5">
    <div class="col-12 col-lg-4 mb-4">
        <div class="list-group" id="list-tab" role="tablist">
           
            <a class="list-group-item list-group-item-action @(currentTab == "welcome" ? "active" : "")"
               id="list-home-list" data-bs-toggle="list" href="#list-home" style="text-align:center;" role="tab"
               aria-controls="list-home">Welcome</a>

            <a class="list-group-item list-group-item-action" id="list-orders-list" data-bs-toggle="list"
               href="#list-orders" style="text-align:center;" role="tab" aria-controls="list-orders">Orders and
                Returns</a>
            <a class="list-group-item list-group-item-action" id="list-card-address-list" data-bs-toggle="list"
               href="#list-card-address" style="text-align:center;" role="tab"
               aria-controls="list-card-address">Cardholder Address</a>

            <a class="list-group-item list-group-item-action @(currentTab == "delivery" ? "active" : "")"
               id="list-delivery-address-list" data-bs-toggle="list" href="#list-delivery-address"
               style="text-align:center;" role="tab" aria-controls="list-delivery-address">Delivery Address</a>

            <a class="list-group-item list-group-item-action @(currentTab == "contact" ? "active" : "")"
               id="list-contact-list" data-bs-toggle="list" href="#list-contact" style="text-align:center;" role="tab"
               aria-controls="list-contact">Contact Details</a>

            <a class="list-group-item list-group-item-action @(currentTab == "wishlist" ? "active" : "")"
                    id="list-wish-list" data-bs-toggle="list" href="#list-wish" style="text-align:center;" role="tab"
                    aria-controls="list-wish">My Wishlist</a>         
                        
                        
            <a class="list-group-item list-group-item-action text-center" asp-area="Identity" asp-page="/Account/Manage/Index" role="button">
                                Account Settings
                        </a>
               

            <div class="list-group-item list-group-item-action p-0">
                <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-link list-group-item list-group-item-action w-100 text-center"
                            id="list-signout-list" style="border: none; padding: 0.75rem 1.25rem; cursor: pointer;">
                        Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade @(currentTab == "welcome" ? "show active" : "")" id="list-home" role="tabpanel"
                 aria-labelledby="list-home-list">
                <div class="card p-4 shadow-sm border-0 bg-light">
                    <h4 class="fw-bold mb-1">Dashboard Home</h4>
                    <p class="text-muted mb-4">Select a tab on the left to manage your shopping account profile.</p>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="border-top pt-3 mt-2">
                            

                            <!-- Display active logged-in user credential name -->

                            <div class="d-flex flex-column flex-sm-row gap-2">
                               <p class="mb-0">Welcome @Model.DeliveryAddress.FirstName !</p>
                               <p class="mt-5">{Placeholder - will show past 5 orders}</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="list-orders" role="tabpanel" aria-labelledby="list-orders-list">...</div>

            <div class="tab-pane fade" id="list-card-address" role="tabpanel" aria-labelledby="list-card-address-list">
                <div class="card p-4 shadow-sm border-0 bg-light">
                    <h4 class="fw-bold mb-1">Cardholder Address</h4>
                    <p class="text-muted mb-0">This section will display cardholder address details.</p>
                </div>
            </div>

            <div class="tab-pane fade @(currentTab == "delivery" ? "show active" : "")" id="list-delivery-address"
                 role="tabpanel" aria-labelledby="list-delivery-address-list">
                
                @await Html.PartialAsync("_GetDeliveryAddressPartial", Model.DeliveryAddress)
                @if (TempData["DeliverySuccess"] != null)
                {
                    <div class="alert alert-success mt-2">
                        @TempData["DeliverySuccess"]
                    </div>
                }

                @if (TempData["DeliveryError"] != null)
                {
                    <div class="alert alert-danger mt-2">
                        @TempData["DeliveryError"]
                    </div>
                }
            </div>

            <div class="tab-pane fade @(currentTab == "contact" ? "show active" : "")" id="list-contact" role="tabpanel"
                 aria-labelledby="list-contact-list">
                
                @await Html.PartialAsync("_GetContactDetailsPartial", Model.ContactDetails)
                @if (TempData["ContactSuccess"] != null)
                {
                    <div class="alert alert-success mt-2">
                        @TempData["ContactSuccess"]
                    </div>
                }

                @if (TempData["ContactError"] != null)
                {
                    <div class="alert alert-danger mt-2">
                        @TempData["ContactError"]
                    </div>
                }
            </div>    
                <div class="tab-pane fade @(currentTab == "wishlist" ? "show active" : "")" id="list-wish" role="tabpanel" 
                aria-labelledby="list-wish-list">
                    @await Html.PartialAsync("_GetWishlistPartial", Model.Wishlist)
                </div>
        </div>
    </div>
</div>

