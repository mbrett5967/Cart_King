@model Cart_King.Models.ViewModels.DashboardViewModel 

@{
    // We can now use the property directly from our Master ViewModel
    var currentTab = Model.ActiveTab ?? "welcome";
}

<div class="row mt-5">
    <div class="col-4">
        <div class="list-group" id="list-tab" role="tablist">
            @* Note: Accessing FirstName via the DeliveryAddress sub-model *@
            <a class="list-group-item list-group-item-action @(currentTab == "welcome" ? "active" : "")" id="list-home-list" data-bs-toggle="list" href="#list-home" style="text-indent:20px;" role="tab" aria-controls="list-home">
                <p>Welcome @Model.DeliveryAddress.FirstName</p>
            </a>
            
            <a class="list-group-item list-group-item-action" id="list-orders-list" data-bs-toggle="list" href="#list-orders" style="text-align:center;" role="tab" aria-controls="list-orders">Orders and Returns</a>
            <a class="list-group-item list-group-item-action" id="list-card-address-list" data-bs-toggle="list" href="#list-card-address" style="text-align:center;" role="tab" aria-controls="list-card-address">Cardholder Address</a>
            
            <a class="list-group-item list-group-item-action @(currentTab == "delivery" ? "active" : "")" id="list-delivery-address-list" data-bs-toggle="list" href="#list-delivery-address" style="text-align:center;" role="tab" aria-controls="list-delivery-address">Delivery Address</a>
            
            <a class="list-group-item list-group-item-action @(currentTab == "contact" ? "active" : "")" id="list-contact-list" data-bs-toggle="list" href="#list-contact" style="text-align:center;" role="tab" aria-controls="list-contact">Contact Details</a>
            
            <a class="list-group-item list-group-item-action" @(currentTab == "password" ? "active" : "") id="list-update-password-list" data-bs-toggle="list" href="#list-update-password" style="text-align:center;" role="tab" aria-controls="list-update-password">Update Password</a>
            <a class="list-group-item list-group-item-action" id="list-wish-list" data-bs-toggle="list" href="#list-wish" style="text-align:center;" role="tab" aria-controls="list-wish">My Wishlist</a>
            
            <a class="list-group-item list-group-item-action">
                <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display: contents;">
                    <button type="submit" class="list-group-item list-group-item-action" id="list-signout-list" style="text-align:center; border: none; background: none; width: 100%; padding: 0.75rem 1.25rem; cursor: pointer;">Sign Out</button>
                </form>
            </a>   
        </div>
    </div>

    <div class="col-8">
        <div class="tab-content" id="nav-tabContent">
            <!-- Welcome Home -->
            <div class="tab-pane fade @(currentTab == "welcome" ? "show active" : "")" id="list-home" role="tabpanel" aria-labelledby="list-home-list">
                <h4>Dashboard Home</h4>
                <p>Select a tab on the left to manage your account.</p>
            </div>

            <!-- Orders (Placeholder) -->
            <div class="tab-pane fade" id="list-orders" role="tabpanel" aria-labelledby="list-orders-list">...</div>

            <!-- Delivery Address Tab -->
            <div class="tab-pane fade @(currentTab == "delivery" ? "show active" : "")" id="list-delivery-address" role="tabpanel" aria-labelledby="list-delivery-address-list">
                @* Pass ONLY the DeliveryAddress part of the model to the partial *@
                @await Html.PartialAsync("_GetDeliveryAddressPartial", Model.DeliveryAddress)
                @if (TempData["DeliverySuccess"] != null)
            {
                <div class="alert alert-success mt-2">
                    @TempData["DeliverySuccess"]
                </div>
            }

            @if (TempData["DeliveryError"] != null)
            {
                <div class="alert alert-danger mt-2">
                    @TempData["DeliveryError"]
                </div>
            }
               
            </div>

            <!-- Contact Details Tab -->
            <div class="tab-pane fade @(currentTab == "contact" ? "show active" : "")" id="list-contact" role="tabpanel" aria-labelledby="list-contact-list">
                @* Pass ONLY the ContactDetails part of the model to the partial *@
                @await Html.PartialAsync("_GetContactDetailsPartial", Model.ContactDetails)
                @if (TempData["ContactSuccess"] != null)
            {
                <div class="alert alert-success mt-2">
                    @TempData["ContactSuccess"]
                </div>
            }

            @if (TempData["ContactError"] != null)
            {
                <div class="alert alert-danger mt-2">
                    @TempData["ContactError"]
                </div>
            }
                
                
            </div>

            <div class="tab-pane fade @(currentTab == "password" ? "show active" : "")" id="list-update-password" role="tabpanel" aria-labelledby="list-update-password-list">
                @await Html.PartialAsync("_ForgotPasswordPartial")
            </div>
            <div class="tab-pane fade" id="list-wish" role="tabpanel" aria-labelledby="list-wish-list">...</div>
        </div>
    </div>
</div>

