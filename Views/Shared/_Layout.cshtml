<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cart King</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cart_King.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm custom-nav" style = "background-color: var(--nav-background), color: var(--nav-text);">
            <div class="container-fluid">
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

               <div class="nav-left">
                  <div class="navbar-nav">
                      <a class="navbar-brand logo" href="/">
                          <img src="~/images/ckLogo.png" alt="Cart King" />
                        </a>
                      <a class="nav-link" asp-controller="Business" asp-action="Index">Business</a>
                      <a class="nav-link" asp-controller="Category" asp-action="Index">Shop</a>
                      <a class="nav-link" asp-controller="Category" asp-action="Index">Sell</a>
                 </div>
              </div>
                
                <div class="nav-right">
                  <div class="navbar-nav">
                     <a class="nav-link" asp-controller="Home" asp-action="Index">Account</a>
                     <a class="nav-link" asp-controller="Home" asp-action="Index">Basket</a>
                 </div>
              </div>
              
    </div>
</nav>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Cart King - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
